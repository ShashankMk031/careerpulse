# ==============================================================================
# CareerPulse Platform Global Configuration Template
# ==============================================================================

# Database schema name created inside the PostgreSQL instance
POSTGRES_DB=serving_db

# Database user name for connection authentication
POSTGRES_USER=postgres

# Database password corresponding to the user above
POSTGRES_PASSWORD=cp_local_postgres_password

# Host address of the database (container service name 'postgres' in docker compose)
POSTGRES_HOST=localhost

# Network port number listening on the database instance
POSTGRES_PORT=5433

# AWS Access Key ID credentials for loading data from S3 Gold layer buckets
AWS_ACCESS_KEY_ID=mock_aws_access_key

# AWS Secret Access Key credentials matching the Access Key ID
AWS_SECRET_ACCESS_KEY=mock_aws_secret_key

# Target AWS region hosting the S3 Gold data bucket
AWS_DEFAULT_REGION=us-east-1

# Target S3 bucket name storing the Parquet tables
S3_GOLD_BUCKET_NAME=careerpulse-data-gold

# Application execution mode environment context (development / production)
APP_ENV=development