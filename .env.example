# ==============================================================================
# CareerPulse Platform Configuration Template
# ==============================================================================
# Copy this file to .env and configure for your local or production environment.
# Do NOT commit your actual .env file with secrets to source control.

# Application Environment Context (development / testing / production)
APP_ENV=development
APP_VERSION=1.0.0
API_DEBUG=false

# Database Environment Target: 'RDS' (AWS RDS PostgreSQL) or 'LOCAL' (Docker/Localhost)
DB_ENVIRONMENT=RDS

# Serving Database Credentials (Standard 12-Factor Variables)
# In RDS mode: Point to your AWS RDS PostgreSQL endpoint on port 5432
# In LOCAL mode: Point to localhost/postgres on port 5433 (or 5432)
DATABASE_HOST=cp-dev-serving-db.c123456789.ap-south-1.rds.amazonaws.com
DATABASE_PORT=5432
DATABASE_NAME=serving_db
DATABASE_USER=postgres
DATABASE_PASSWORD=your_secure_database_password
DATABASE_SCHEMA=serving

# Connection Pool Sizing
DB_MIN_CONN=2
DB_MAX_CONN=10

# API Gateway Networking & CORS Configuration
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated list of allowed origins, or '*' for development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost

# Cache Header Expirations (seconds)
CACHE_MAX_AGE_SUMMARY=300
CACHE_MAX_AGE_ANALYTICS=3600

# AWS Cloud Infrastructure & Data Lake Configuration
AWS_REGION=ap-south-1
S3_BUCKET=cp-dev-datalake-321422008826
S3_GOLD_BUCKET_NAME=cp-dev-datalake-321422008826

# Optional: AWS IAM Credentials (if not using IAM roles / AWS SSO / default profile)
# AWS_ACCESS_KEY_ID=your_access_key_id
# AWS_SECRET_ACCESS_KEY=your_secret_access_key