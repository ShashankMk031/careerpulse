# ==============================================================================
# CareerPulse FastAPI Backend Configuration Template
# ==============================================================================
# Copy this file to backend/.env or configure in root .env

APP_ENV=development
APP_VERSION=1.0.0
API_DEBUG=false
API_HOST=0.0.0.0
API_PORT=8000

# Database Environment Target ('RDS' or 'LOCAL')
DB_ENVIRONMENT=RDS

# Serving Database Credentials (Standard 12-Factor Variables)
DATABASE_HOST=cp-dev-serving-db.c123456789.ap-south-1.rds.amazonaws.com
DATABASE_PORT=5432
DATABASE_NAME=serving_db
DATABASE_USER=postgres
DATABASE_PASSWORD=your_secure_database_password
DATABASE_SCHEMA=serving

# Connection Pool Settings
DB_MIN_CONN=2
DB_MAX_CONN=10

# Allowed CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost

# Cache Expirations (seconds)
CACHE_MAX_AGE_SUMMARY=300
CACHE_MAX_AGE_ANALYTICS=3600

# AWS S3 Data Lake Configuration
AWS_REGION=ap-south-1
S3_GOLD_BUCKET_NAME=cp-dev-datalake-321422008826
