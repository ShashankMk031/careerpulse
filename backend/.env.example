# ==============================================================================
# CareerPulse FastAPI Backend Configuration Template
# ==============================================================================

# Application environment context (development / production)
APP_ENV=development

# Logging output detail level (debug, info, warning, error)
LOG_LEVEL=info

# PostgreSQL target database name
POSTGRES_DB=serving_db

# PostgreSQL database authentication user
POSTGRES_USER=postgres

# PostgreSQL database authentication password
POSTGRES_PASSWORD=cp_local_postgres_password

# Host address of the database (container name 'postgres' inside docker compose)
POSTGRES_HOST=postgres

# Internal network port database listens on
POSTGRES_PORT=5432

# AWS credentials enabling pipeline synchronization from Parquet data lakes
AWS_ACCESS_KEY_ID=mock_aws_access_key
AWS_SECRET_ACCESS_KEY=mock_aws_secret_key
AWS_DEFAULT_REGION=us-east-1
S3_GOLD_BUCKET_NAME=careerpulse-data-gold
